{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quick",
  "version": "0.1.0",
  "identifier": "com.Newbee.Quick",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "fullscreen": false,
        "height": 230,
        "resizable": false,
        "title": "quick",
        "decorations": false,
        "width": 50,
        "titleBarStyle": "Overlay",
        "visible": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "contentProtected": false,
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "focus": true,
        "transparent": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
